{
  "name": "LemonadeP Android Kernel Builder Root",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "root",
  "containerUser": "root",
  "overrideCommand": true,
  "forwardPorts": [2222],
  "portsAttributes": {
    "2222": {
      "label": "SSH",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "/usr/sbin/sshd"
}
