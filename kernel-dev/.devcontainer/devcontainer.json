{
    "name": "Linux Kernel Build Environment",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": ".."
    },
    "remoteUser": "root",
    "containerUser": "root",
    "workspaceFolder": "/workspace",
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt=seccomp=unconfined"
    ],
    "hostRequirements": {
        "cpus": 4,
        "memory": "8gb"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.makefile-tools",
                "eamodio.gitlens"
            ]
        }
    }
}
